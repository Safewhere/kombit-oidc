{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SampleApi": {
    // The issuer of Identify. The API reads {Issuer}/.well-known/openid-configuration and rejects a discovery document with another issuer.
    "Issuer": "https://dev.safewhere.local/runtime/oauth2",
    // The API identifier. The client connection must have it in ApplicationAudience, so that the access token has it in aud.
    "Audience": "urn:kombit-oidc:sample-api",
    // The base of the htu claim of the DPoP proofs. Behind a reverse proxy, the public URL.
    "PublicBaseUrl": "https://localhost:44392",
    // The client ID of the API connection, which calls introspection with private_key_jwt.
    "ClientId": "fapi-test-api",
    // Set the path and the password of the key of the client assertion in user secrets, never here.
    "AssertionSigningCertPath": "",
    "AssertionSigningCertPassword": ""
  }
}
