{
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "OpenIdConnectOptions": {
    "ClientId": "oidc-code-flow",
    // For demo purpose only. You should store client secret somewhere that is more secure.
    "ClientSecret": "client_secret",
    "ResponseType": "code",
    "RequireNonce": "true",
    "ResponseMode": "",
    "AuthorizationEndpointMethod": "GET", // GET or POST
    "TokenAuthnMethod": "client_secret_post", // or client_secret_basic, private_key_jwt, none, tls_client_auth, or self_signed_tls_client_auth (mutual TLS, see MutualTls)
    // Note that Identify OAuth server encrypts the ID token by using the public key (use="enc") from the jwks or jwks_uri configured in the Identify OAuth/OIDC connection. So the jwks or jwks_uri must contain the public certificate in a key (use="enc") which corresponds to the bellow configured ID token decryption certificate.
    "IdTokenDecryptionCertPath": "",
    "IdTokenDecryptionCertPassword": "",
    // Certificate to sign the client_assertion for the private_key_jwt authentication method, the jwks or jwks_uri must contain the public certificate (use=sig) which corresponds to the bellow configured Jwt Assertion Signing certificate.
    "JwtAssertionSigningCertPath": "", // required for private_key_jwt authentication method
    "JwtAssertionSigningCertPassword": "", // required for private_key_jwt authentication method
    // The issuer of Identify. The sample reads every Identify endpoint from {ClaimsIssuer}/.well-known/openid-configuration and rejects a discovery document with another issuer.
    "ClaimsIssuer": "https://dev.safewhere.local/runtime/oauth2",
    "Scope": "openid",
    "EnableSessionManagement": "false",
    "EnablePostLogout": "true",
    // OAuth building blocks. Each block is independent; the README shows the combination for FAPI 2.0. An invalid value stops the application at startup.
    "PushedAuthorization": "Disable", // Disable, UseIfAvailable, or Require (RFC 9126)
    "ClientAssertion": {
      "Audience": "TokenEndpoint", // TokenEndpoint or Issuer (for the Identify rule clientAssertion.audience=issuer)
      "SigningAlgorithm": "RS256" // RS256, RS384, RS512, PS256, PS384, or PS512
    },
    "DPoP": {
      "BindAccessTokens": false, // a DPoP proof with every token request; the token response must have token_type=DPoP (RFC 9449)
      "SendDPoPJkt": false, // dpop_jkt in the authorization request binds the code to the DPoP key
      "SendProofToParEndpoint": false, // a DPoP proof with the PAR request binds the code to the DPoP key
      "SigningAlgorithm": "PS256" // RS256, RS384, RS512, PS256, PS384, or PS512
    },
    "MutualTls": {
      // With TokenAuthnMethod tls_client_auth or self_signed_tls_client_auth, or with UseEndpointAliases, the PAR, token, revocation, and introspection requests go to the mtls_endpoint_aliases of the discovery document with this client certificate (RFC 8705).
      "UseEndpointAliases": false, // true binds the access tokens to the certificate also with another TokenAuthnMethod, for example private_key_jwt
      "CertificateThumbprint": "", // a certificate in the store My of the current user or of the local computer; set this or CertificatePath
      "CertificatePath": "", // a PFX file
      "CertificatePassword": "" // the password of the PFX file; keep it in user secrets
    },
    "ValidIdTokenSigningAlgorithms": "" // for example "PS256"; empty keeps the library default
  },
  "Testing": {
    "EnableFaultInjection": false, // shows deliberate protocol violations for negative tests; never true for a production client
    "OtherClientId": "" // another client, for the faults RedeemAsOtherClient, RefreshAsOtherClient, and AssertionIssuerNotClient
  }
}
